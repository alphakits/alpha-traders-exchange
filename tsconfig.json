{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@alpha-traders/contracts": [
        "./packages/contracts/src/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-dev/types/**/*.ts",
    ".next-runtime/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-runtime-build/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "apps/mobile",
    "e2e/new-buyer-seller-application.spec.ts",
    "src/__tests__/admin-approved-sellers-privacy.test.ts",
    "src/__tests__/legacy-pending-seller-normalization.test.ts"
  ]
}
