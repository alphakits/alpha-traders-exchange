# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/discord-worker/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-dev/
/.next-runtime/
/.next-runtime-build/
/.next-stale/
/out/

# production
/build
/discord-worker/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Runtime database (seeded from data/alpha-exchange-db.json)
/data/alpha-exchange-evidence/
/data/alpha-exchange-repo-trace.log

# Railway discord-worker deploy context: exclude large web static bundle not used by Dockerfile.discord-worker
/public/files/

# Debug / QA artifacts
recovery-codes.txt
cookies.txt
build.log
build-output.txt
tmp-*.js
tmp-*.mjs
tmp-*.ts
tmp-*.png
/tmp/
/test-results/
.next-runtime-test-*/
