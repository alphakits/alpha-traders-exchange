# Local/build artifacts
.next
node_modules
data/*.log

# Oversized local media not supported by Vercel file limits
public/files/**/*.mp4

# Vercel's default upload ignore list omits Docker build-context rules.
!.dockerignore

# Keep Docker and Buildah web-specific context rules in the exact upload.
!Dockerfile.vercel.dockerignore
!Dockerfile.vercel.containerignore
