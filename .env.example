# Required in Vercel
NEXT_PUBLIC_SITE_URL=https://www.alphatraders.co.il
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PostgreSQL connection string — MUST use the Supabase connection POOLER, not the direct host.
# Direct host (db.<ref>.supabase.co) is NOT reachable from Vercel serverless functions.
#
# Correct format (Transaction Mode Pooler, port 6543):
#   SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# How to get this URL:
#   Supabase Dashboard → Project Settings → Database → Connection Pooling → Transaction mode → copy URI
#
# WRONG (direct host — causes ENOTFOUND on Vercel):
#   SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=

SUPABASE_SERVICE_ROLE_KEY=

# Transactional authentication and marketplace email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Alpha Exchange <notifications@your-verified-domain.example>

# Founder video — must be hosted on Supabase Storage (not Git LFS) because
# Vercel does not pull LFS objects during deployment.
# Upload the file to Supabase Storage and set this to the public URL:
#   https://<project-ref>.supabase.co/storage/v1/object/public/admin-media/founder/alpha-traders-founder-introduction.mp4
# How to upload: Supabase Dashboard → Storage → admin-media bucket → Upload
NEXT_PUBLIC_FOUNDER_VIDEO_URL=

# Optional runtime configuration
AUTH_COOKIE_SECURE=true
ADMIN_ACCESS_KEY=
ALPHA_EXCHANGE_LARGE_TRADE_THRESHOLD=50000
ALPHA_EXCHANGE_EVIDENCE_MAX_SIZE_MB=8
ALPHA_EXCHANGE_STALE_TRADE_TIMEOUT_MINUTES=20
# Optional local-only seed. Never enable in production.
ALPHA_EXCHANGE_SEED_DEVELOPMENT_TESTER_LISTING=0
SUPABASE_ADMIN_MEDIA_BUCKET=admin-media
# SUPABASE_DB_SSL=true

# Discord infrastructure
# Server-only. Required when the Discord gateway service is explicitly initialized.
DISCORD_BOT_TOKEN=
# Discord application snowflake used to verify the authenticated bot identity.
DISCORD_APPLICATION_ID=
# Guild snowflake fetched from Discord during startup to verify bot access.
DISCORD_GUILD_ID=
DISCORD_BLUEPRINT_PATH=scripts/discord/alpha-discord-blueprint.json
DISCORD_DRY_RUN=0

# Discord marketplace integration
DISCORD_MARKETPLACE_WEBHOOK_URL=
DISCORD_MARKETPLACE_API_KEY=
DISCORD_MARKETPLACE_WEBHOOK_SECRET=
DISCORD_MARKETPLACE_AVATAR_URL=

# Set to "1" to bypass Twilio phone verification requirement for all marketplace actions.
# Use this during the pre-Twilio phase so approved sellers can trade without SMS verification.
# Remove or set to "0" once Twilio is live and all sellers have verified phones.
# Admin and Owner accounts always bypass phone verification regardless of this setting.
ALPHA_EXCHANGE_SKIP_PHONE_VERIFICATION=1

# Development-only verification bypass list (comma-separated lowercase emails).
# Use only temporary test accounts while verification flows are under development.
# Remove this variable entirely to disable the bypass immediately.
PHOTO_VERIFICATION_BYPASS_EMAILS=jozemark@gmail.com

# Forbidden in production
# ALPHA_EXCHANGE_EXPOSE_RESET_TOKEN=false

# ── Blockchain Commission Verification ────────────────────────────────────────
#
# Etherscan V2 unified API key.
# V2 covers ALL supported chains (Ethereum, Polygon) with a single key and
# a chainid parameter. V1 per-chain endpoints are deprecated and no longer work.
# Register for free at https://etherscan.io/register
# Docs: https://docs.etherscan.io/v2-migration
#
# Without this key, the verifier falls back to a public JSON-RPC endpoint
# (cloudflare-eth.com / polygon-rpc.com) which has lower rate limits.
#
ALPHA_EXCHANGE_ETHERSCAN_API_KEY=
#
# ALPHA_EXCHANGE_POLYGONSCAN_API_KEY is no longer used.
# Etherscan V2 uses the single ALPHA_EXCHANGE_ETHERSCAN_API_KEY for all chains.
#
# Optional: override the public RPC fallback URL for each network.
# Useful for pointing at a private Infura / Alchemy / QuickNode endpoint.
# Defaults: cloudflare-eth.com (Ethereum) and polygon-rpc.com (Polygon).
#
# ALPHA_EXCHANGE_ETH_RPC_URL=https://mainnet.infura.io/v3/<project-id>
# ALPHA_EXCHANGE_POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/<project-id>
#
# Minimum on-chain confirmations required before a payment is accepted (default: 3).
# ALPHA_EXCHANGE_EVM_MIN_CONFIRMATIONS=3
