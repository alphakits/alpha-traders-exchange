# Required in Vercel
NEXT_PUBLIC_SITE_URL=https://www.alphatraders.co.il
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PostgreSQL connection string — MUST use the Supabase connection POOLER, not the direct host.
# Direct host (db.<ref>.supabase.co) is NOT reachable from Vercel serverless functions.
#
# Correct format (Transaction Mode Pooler, port 6543):
#   SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# How to get this URL:
#   Supabase Dashboard → Project Settings → Database → Connection Pooling → Transaction mode → copy URI
#
# WRONG (direct host — causes ENOTFOUND on Vercel):
#   SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=

SUPABASE_SERVICE_ROLE_KEY=

# Transactional authentication and marketplace email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Alpha Exchange <notifications@your-verified-domain.example>

# Founder video — must be hosted on Supabase Storage (not Git LFS) because
# Vercel does not pull LFS objects during deployment.
# Upload the file to Supabase Storage and set this to the public URL:
#   https://<project-ref>.supabase.co/storage/v1/object/public/admin-media/founder/alpha-traders-founder-introduction.mp4
# How to upload: Supabase Dashboard → Storage → admin-media bucket → Upload
NEXT_PUBLIC_FOUNDER_VIDEO_URL=

# Optional runtime configuration
AUTH_COOKIE_SECURE=true
ADMIN_ACCESS_KEY=
ALPHA_EXCHANGE_LARGE_TRADE_THRESHOLD=50000
ALPHA_EXCHANGE_EVIDENCE_MAX_SIZE_MB=8
ALPHA_EXCHANGE_STALE_TRADE_TIMEOUT_MINUTES=20
# Optional local-only seed. Never enable in production.
ALPHA_EXCHANGE_SEED_DEVELOPMENT_TESTER_LISTING=0
SUPABASE_ADMIN_MEDIA_BUCKET=admin-media
# PostgreSQL TLS certificate and hostname verification are enabled by default.
# Set the provider CA PEM only when it is not already in the Node.js trust store.
# SUPABASE_DB_CA="-----BEGIN CERTIFICATE-----..."

# Discord Railway worker infrastructure
# Set the bot token and guild ID only on the dedicated long-lived Railway worker.
# Server-only Discord bot credential. Never expose it to Vercel or browser code.
DISCORD_BOT_TOKEN=
# Discord application snowflake used by Railway to verify the bot identity.
DISCORD_APPLICATION_ID=
# Website OAuth application identifier. Usually equal to DISCORD_APPLICATION_ID,
# but intentionally configured separately on Vercel.
DISCORD_CLIENT_ID=
# Website-only OAuth credential. Set on Vercel, never in browser variables and
# never substitute DISCORD_BOT_TOKEN. Required before enabling account linking.
DISCORD_CLIENT_SECRET=
# Exact callback registered in the Discord Developer Portal. HTTPS only in production.
DISCORD_REDIRECT_URI=https://www.alphatraders.co.il/api/discord/oauth/callback
# Guild snowflake fetched from Discord during startup to verify bot access.
DISCORD_GUILD_ID=
# Railway also requires the same PostgreSQL database through DATABASE_URL or
# SUPABASE_DB_URL so the worker can consume the durable role-sync outbox.
# Generate a dedicated random value of at least 32 characters. Set the same value
# on Railway and Vercel; it authenticates signed, short-lived readiness probes.
# Do not reuse DISCORD_BOT_TOKEN or any application/admin credential.
DISCORD_WORKER_HEALTH_SECRET=
# Set only on Vercel. Must be the Railway worker's fixed public HTTPS origin,
# with no path, query, fragment, or embedded credentials.
DISCORD_WORKER_BASE_URL=https://your-discord-worker.example
# Optional display-name overrides for Railway-managed Discord resources.
# Stable resource keys and Discord IDs remain database-managed.
DISCORD_SELLER_CATEGORY_NAME=🛡️ Seller Lounge
DISCORD_SELLER_LOUNGE_CHANNEL_NAME=seller-lounge
DISCORD_SELLER_ANNOUNCEMENTS_CHANNEL_NAME=📢 seller-announcements
DISCORD_SELLER_UPDATES_CHANNEL_NAME=seller-updates
DISCORD_SELLER_CHAT_CHANNEL_NAME=💬 seller-chat
DISCORD_SELLER_GUIDES_CHANNEL_NAME=📚 seller-guides
DISCORD_SELLER_SUPPORT_CHANNEL_NAME=❓ seller-support
DISCORD_SELLER_SUCCESS_CHANNEL_NAME=🚀 share-your-success
DISCORD_MARKETPLACE_CATEGORY_NAME=💰 Alpha Exchange
DISCORD_MARKETPLACE_LISTINGS_CHANNEL_NAME=📢 marketplace-listings
DISCORD_MARKET_ACTIVITY_CHANNEL_NAME=📈 market-activity
DISCORD_LIVE_MARKET_PULSE_CHANNEL_NAME=🔥 live-market-pulse
DISCORD_BUYER_SUPPORT_CHANNEL_NAME=💬 buyer-support

# Discord setup/provisioning scripts
DISCORD_BLUEPRINT_PATH=scripts/discord/alpha-discord-blueprint.json
DISCORD_DRY_RUN=0

# Discord marketplace integration
DISCORD_MARKETPLACE_WEBHOOK_URL=
DISCORD_MARKETPLACE_API_KEY=
DISCORD_MARKETPLACE_WEBHOOK_SECRET=
DISCORD_MARKETPLACE_AVATAR_URL=

# Security: leave all phone-verification bypasses unset. They are rejected in a
# deployed production runtime and are only accepted by the explicit local test runtime.
# ALPHA_EXCHANGE_SKIP_PHONE_VERIFICATION=1
# PHOTO_VERIFICATION_BYPASS_EMAILS=

# Forbidden in production
# ALPHA_EXCHANGE_EXPOSE_RESET_TOKEN=false

# Optional server-only Twilio SMS. SMS delivery and phone verification return an explicit
# configuration error until all three are set. Never expose these as NEXT_PUBLIC variables.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+15551234567

# ── Blockchain Commission Verification ────────────────────────────────────────
#
# Etherscan V2 unified API key.
# V2 covers ALL supported chains (Ethereum, Polygon) with a single key and
# a chainid parameter. V1 per-chain endpoints are deprecated and no longer work.
# Register for free at https://etherscan.io/register
# Docs: https://docs.etherscan.io/v2-migration
#
# Without this key, the verifier falls back to a public JSON-RPC endpoint
# (cloudflare-eth.com / polygon-rpc.com) which has lower rate limits.
#
ALPHA_EXCHANGE_ETHERSCAN_API_KEY=
#
# ALPHA_EXCHANGE_POLYGONSCAN_API_KEY is no longer used.
# Etherscan V2 uses the single ALPHA_EXCHANGE_ETHERSCAN_API_KEY for all chains.
#
# Optional: override the public RPC fallback URL for each network.
# Useful for pointing at a private Infura / Alchemy / QuickNode endpoint.
# Defaults: cloudflare-eth.com (Ethereum) and polygon-rpc.com (Polygon).
#
# ALPHA_EXCHANGE_ETH_RPC_URL=https://mainnet.infura.io/v3/<project-id>
# ALPHA_EXCHANGE_POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/<project-id>
#
# Minimum on-chain confirmations required before a payment is accepted (default: 3).
# ALPHA_EXCHANGE_EVM_MIN_CONFIRMATIONS=3
