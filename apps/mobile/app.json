{
  "expo": {
    "name": "Alpha Traders",
    "slug": "alpha-traders",
    "owner": "alpha-traders",
    "version": "1.1.0",
    "description": "Secure bilingual USDT marketplace and guided P2P trading for Alpha Traders.",
    "icon": "../../public/images/brand/alpha-traders-app-icon-1024.png",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "scheme": "alphatraders",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.alphakits.alphatraders",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "android": {
      "package": "com.alphakits.alphatraders",
      "allowBackup": false,
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "../../public/images/brand/alpha-traders-app-icon-maskable-1024.png",
        "backgroundColor": "#050505"
      }
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow Alpha Traders to use Face ID to unlock and protect your app."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050505",
          "image": "../../public/images/brand/alpha-traders-app-icon-1024.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Alpha Traders to select a payment or USDT transfer receipt for your active trade.",
          "cameraPermission": "Allow Alpha Traders to use your camera to photograph payment or USDT transfer evidence for an active trade.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D4AF37",
          "defaultChannel": "alpha-trade-updates"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiVersion": "v1",
      "eas": {
        "projectId": "e5dbc3ba-25fb-4373-8ded-c8c80cadc147"
      }
    }
  }
}
