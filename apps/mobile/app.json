{
  "expo": {
    "name": "Alpha Traders",
    "slug": "alpha-traders",
    "owner": "alpha-traders",
    "version": "1.0.0",
    "description": "Secure bilingual USDT marketplace and guided P2P trading for Alpha Traders.",
    "icon": "../../public/images/brand/alpha-traders-logo-512.png",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "scheme": "alphatraders",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.alphakits.alphatraders",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.alphakits.alphatraders",
      "allowBackup": false,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "../../public/images/brand/alpha-traders-logo-maskable-512.png",
        "backgroundColor": "#050505"
      }
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050505",
          "image": "../../public/images/brand/alpha-traders-logo-512.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Alpha Traders to select a payment or USDT transfer receipt for your active trade.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiVersion": "v1",
      "eas": {
        "projectId": "e5dbc3ba-25fb-4373-8ded-c8c80cadc147"
      }
    }
  }
}
