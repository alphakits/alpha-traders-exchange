{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@alpha-traders/contracts": [
        "../../packages/contracts/src/index.ts"
      ],
      "@alpha-traders/design-tokens": [
        "../../packages/design-tokens/src/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
