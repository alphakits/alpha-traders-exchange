{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/check-commission-batch-release.mjs && npm run build",
  "fluid": true,
  "regions": ["dub1"],
  "crons": [
    {
      "path": "/api/cron/economic-news",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/trade-action-reminders",
      "schedule": "1-59/5 * * * *"
    },
    {
      "path": "/api/cron/commission-payment-verification",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/whatsapp-delivery",
      "schedule": "3-59/5 * * * *"
    },
    {
      "path": "/api/cron/marketplace-email-delivery",
      "schedule": "* * * * *"
    }
  ]
}
