{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/check-commission-checkout-release.mjs && node scripts/check-commission-batch-release.mjs && npm run build",
  "env": { "ALPHA_EXCHANGE_COMMISSION_BATCH_V1": "1", "ALPHA_EXCHANGE_COMMISSION_CHECKOUT_V1": "1" },
  "fluid": true,
  "regions": ["dub1"],
  "crons": [
    { "path": "/api/cron/economic-news", "schedule": "* * * * *" },
    { "path": "/api/cron/trade-action-reminders", "schedule": "1-59/5 * * * *" },
    { "path": "/api/cron/commission-payment-verification", "schedule": "* * * * *" },
    { "path": "/api/cron/commission-checkout", "schedule": "* * * * *" },
    { "path": "/api/cron/whatsapp-delivery", "schedule": "3-59/5 * * * *" },
    { "path": "/api/cron/marketplace-email-delivery", "schedule": "* * * * *" }
  ]
}
