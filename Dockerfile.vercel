# Pin the serving runtime as well as the build runtime to the security release.
FROM docker.io/library/node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY . .
RUN node -e "if (process.versions.node !== '24.22.1') process.exit(1)"
RUN npm ci --include=dev

# Consume public build inputs only. Deployment tooling must blank private
# project variables in build.env while preserving their runtime configuration.
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_SITE_URL
ENV NODE_ENV=production \
    ALPHA_USDT_REQUESTS_ENABLED=1 \
    ALPHA_USDT_REQUEST_EMAIL_DELIVERY_ENABLED=0 \
    ALPHA_EXCHANGE_COMMISSION_BATCH_V1=1 \
    ALPHA_EXCHANGE_COMMISSION_CHECKOUT_V1=1
RUN test -n "$NEXT_PUBLIC_SUPABASE_URL" && \
    test -n "$NEXT_PUBLIC_SUPABASE_ANON_KEY" && \
    test -n "$NEXT_PUBLIC_SITE_URL" && \
    node --test scripts/test-container-server.mjs && \
    node scripts/check-commission-checkout-release.mjs && \
    node scripts/check-commission-batch-release.mjs && \
    npm run build
RUN npm prune --omit=dev --ignore-scripts && \
    node scripts/patch-expo-uri-decoder.mjs --check && \
    node scripts/patch-dependency-security.mjs --check

FROM docker.io/library/node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=8080
COPY --from=build --chown=node:node /app/package.json ./package.json
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/packages ./packages
COPY --from=build --chown=node:node /app/.next ./.next
COPY --from=build --chown=node:node /app/public ./public
COPY --from=build --chown=node:node /app/scripts/container-origin.cjs /app/scripts/container-server.cjs ./scripts/
COPY --from=build --chown=node:node /app/scripts/container-next-config.cjs ./next.config.js
# Image optimization writes its ephemeral cache as the unprivileged server.
RUN mkdir -p .next/cache && chown node:node .next .next/cache
USER node
EXPOSE 8080
CMD ["node", "scripts/container-server.cjs"]
