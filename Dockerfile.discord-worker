FROM node:22.18.0-alpine AS build

WORKDIR /app/discord-worker
COPY discord-worker/package.json discord-worker/package-lock.json ./
RUN npm ci

COPY src/workers/discord-worker.ts /app/src/workers/discord-worker.ts
COPY src/lib /app/src/lib
COPY packages/contracts/src /app/packages/contracts/src
RUN npm run build && npm prune --omit=dev

FROM node:22.18.0-alpine AS runtime

RUN apk add --no-cache python3 curl
ENV NODE_ENV=production
WORKDIR /app/discord-worker
COPY --from=build /app/discord-worker/dist ./dist
COPY --from=build /app/discord-worker/node_modules ./node_modules
COPY --from=build /app/discord-worker/package.json ./package.json
COPY scripts/production_health.py ./scripts/production_health.py

USER node
CMD ["node", "--conditions=react-server", "dist/discord-worker.js"]
