{
  "name": "alpha-traders",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); ['.next','.next-dev','.next-runtime','.next-runtime-build','.next-stale'].forEach((dir)=>{ if (fs.existsSync(dir)) fs.rmSync(dir,{recursive:true,force:true}); });\"",
    "dev": "node scripts/ensure-single-dev.mjs && node ./node_modules/next/dist/bin/next dev",
    "dev:clean": "npm run clean && npm run dev",
    "dev:e2e": "npm run clean && node scripts/ensure-single-dev.mjs && node ./node_modules/next/dist/bin/next dev",
    "build": "node scripts/ensure-no-active-dev.mjs && node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "node ./node_modules/eslint/bin/eslint.js",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "test:e2e": "node ./node_modules/playwright/cli.js test",
    "test:coverage": "node ./node_modules/vitest/vitest.mjs run --coverage",
    "discord:inspect": "node scripts/discord/inspect-alpha-discord.mjs",
    "discord:verify": "node scripts/discord/verify-alpha-discord-auth.mjs",
    "discord:post-setup": "npm run discord:verify && npm run discord:inspect",
    "discord:provision": "node scripts/discord/provision-alpha-discord.mjs",
    "discord:commands": "node scripts/discord/register-alpha-slash-commands.mjs",
    "discord:worker": "node --conditions=react-server --import tsx src/workers/discord-worker.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "@types/qrcode": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "discord.js": "^14.27.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.25.0",
    "next": "15.5.20",
    "next-intl": "^4.13.2",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.81.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
