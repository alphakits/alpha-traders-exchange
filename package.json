{
  "name": "alpha-traders",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); ['.next','.next-dev','.next-runtime','.next-runtime-build','.next-stale'].forEach((dir)=>{ if (fs.existsSync(dir)) fs.rmSync(dir,{recursive:true,force:true}); });\"",
    "dev": "node scripts/ensure-single-dev.mjs && node ./node_modules/next/dist/bin/next dev",
    "dev:clean": "npm run clean && npm run dev",
    "dev:e2e": "npm run clean && node scripts/ensure-single-dev.mjs && node ./node_modules/next/dist/bin/next dev",
    "build": "node scripts/ensure-no-active-dev.mjs && npm run test:seo-discovery && npm run test:owner-analytics && node scripts/build-production.mjs",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "node ./node_modules/eslint/bin/eslint.js",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:seo-discovery": "node scripts/check-public-discovery.mjs",
    "test:owner-analytics": "node scripts/check-owner-live-analytics.mjs && node scripts/check-owner-analytics-reporting.mjs && node scripts/check-owner-analytics-finalization.mjs",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "test:e2e": "node ./node_modules/playwright/cli.js test",
    "test:coverage": "node ./node_modules/vitest/vitest.mjs run --coverage",
    "verify:release": "node scripts/release-safety-gate.mjs",
    "verify:release:full": "node scripts/release-safety-gate.mjs --with-e2e",
    "discord:inspect": "node scripts/discord/inspect-alpha-discord.mjs",
    "discord:verify": "node scripts/discord/verify-alpha-discord-auth.mjs",
    "discord:post-setup": "npm run discord:verify && npm run discord:inspect",
    "discord:provision": "node scripts/discord/provision-alpha-discord.mjs",
    "discord:commands": "node scripts/discord/register-alpha-slash-commands.mjs",
    "discord:worker": "node --conditions=react-server --import tsx src/workers/discord-worker.ts",
    "mobile:start": "npm --workspace @alpha-traders/mobile run start",
    "mobile:ios": "npm --workspace @alpha-traders/mobile run ios",
    "mobile:android": "npm --workspace @alpha-traders/mobile run android",
    "mobile:clean": "node -e \"const fs=require('fs'); const dir='apps/mobile/dist'; if (fs.existsSync(dir)) fs.rmSync(dir,{recursive:true,force:true});\"",
    "mobile:doctor": "npm --workspace @alpha-traders/mobile run doctor",
    "mobile:typecheck": "npm --workspace @alpha-traders/mobile run typecheck",
    "mobile:store-readiness": "node scripts/verify-mobile-store-readiness.mjs",
    "mobile:store-readiness:submission": "node scripts/verify-mobile-store-readiness.mjs --submission --platform=all",
    "mobile:store-readiness:submission:ios": "node scripts/verify-mobile-store-readiness.mjs --submission --platform=ios",
    "mobile:store-readiness:submission:android": "node scripts/verify-mobile-store-readiness.mjs --submission --platform=android",
    "mobile:review-rehearsal": "node ./node_modules/vitest/vitest.mjs run src/__tests__/app-review-rehearsal.test.ts",
    "mobile:scale-rehearsal": "node ./node_modules/vitest/vitest.mjs run src/__tests__/marketplace-concurrency-scale.test.ts",
    "mobile:review-surface": "node scripts/verify-mobile-review-surface.mjs",
    "mobile:export": "npm run mobile:clean && npm --workspace @alpha-traders/mobile run export",
    "mobile:verify": "npm run mobile:typecheck && npm run mobile:doctor && npm run mobile:store-readiness && npm run mobile:export",
    "postinstall": "node scripts/patch-expo-uri-decoder.mjs"
  },
  "dependencies": {
    "@alpha-traders/contracts": "*",
    "@hookform/resolvers": "^5.4.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "@types/qrcode": "^1.5.6",
    "@vercel/functions": "^3.9.7",
    "@vercel/speed-insights": "2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decode-uri-component": "0.5.0",
    "discord.js": "^14.27.0",
    "expo": "~57.0.25",
    "lucide-react": "^1.25.0",
    "next": "15.5.25",
    "next-intl": "^4.13.2",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.81.0",
    "react-native-screens": "4.26.2",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "uuid": "11.1.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.28.1": true,
    "@swc/core@1.15.43": true,
    "unrs-resolver@1.12.2": true
  }
}
